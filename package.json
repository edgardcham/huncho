{
  "name": "huncho",
  "version": "0.0.1",
  "description": "Decisions as code. Typed questions, thresholds with hysteresis, nested decisions, journal, replay and calibration over decision models. Providers: TypeSafe Jev, OpenRouter, Vercel AI Gateway.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./testing": {
      "types": "./dist/src/testing.d.ts",
      "import": "./dist/src/testing.js"
    }
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --env-file-if-exists=.env.local --test dist/test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "decisions",
    "probability",
    "classification",
    "routing",
    "calibration",
    "jev",
    "typesafe",
    "openrouter",
    "ai-gateway"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/edgardcham/huncho.git"
  }
}
